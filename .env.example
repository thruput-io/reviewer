# ==============================================================================
# Antigravity (agy) + Azure DevOps MCP Container Environment Configuration
# ==============================================================================

# --- Antigravity / LLM Configuration ---
# Your Gemini API Key from Google AI Studio / Vertex AI
GEMINI_API_KEY=your_gemini_api_key_here

# Optional: Override the model used by agy (e.g. gemini-2.5-pro, gemini-2.5-flash)
# AGY_MODEL=gemini-2.5-pro

# --- Azure DevOps Configuration ---
# Azure DevOps Organization Name or URL (e.g., 'myorg' or 'https://dev.azure.com/myorg')
AZURE_DEVOPS_ORG=my-org-name

# Azure DevOps Personal Access Token (PAT) with Code (Read & Write) and Work Items (Read & Write) scopes
AZURE_DEVOPS_PAT=your_ado_personal_access_token_here

# Default Azure DevOps Project
AZURE_DEVOPS_PROJECT=MyProject

# Optional: Default Azure DevOps Team
# AZURE_DEVOPS_TEAM=MyTeam

# Optional: Enabled MCP Tool Domains (comma-separated: core,repositories,work-items,work,pipelines,wiki,search)
# AZURE_DEVOPS_DOMAINS=core,repositories,work-items,work,pipelines

# Optional: MCP Auth Method (envvar, azcli, interactive)
# AZURE_DEVOPS_AUTH_METHOD=envvar

# --- Git Configuration ---
# Committer identity for local and automated git actions
GIT_USER_NAME=Antigravity Agent
GIT_USER_EMAIL=antigravity@example.com
GIT_DEFAULT_BRANCH=main

# --- Container / Logging Settings ---
# AGY_VERBOSE=1
# LOG_LEVEL=info
