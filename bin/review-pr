#!/usr/bin/env bash
set -e

# ==============================================================================
# Azure DevOps PR Reviewer
# ==============================================================================

# Allow direct command execution (e.g. `docker run reviewer bash`)
if [ "$1" = "bash" ] || [ "$1" = "sh" ] || [ "$1" = "agy" ]; then
    exec "$@"
fi

# Environment & Git setup
export HOME="${HOME:-/home/agyuser}"
export WORKSPACE_DIR="${WORKSPACE_DIR:-/workspace}"
git config --global --add safe.directory "*" || true

# Ensure settings.json with default tool permissions exists
SETTINGS_FILE="${HOME}/.gemini/antigravity-cli/settings.json"
if [ ! -f "$SETTINGS_FILE" ]; then
    mkdir -p "${HOME}/.gemini/antigravity-cli"
    cat <<'EOF' > "$SETTINGS_FILE"
{
  "modelProvider": "gemini",
  "permissions": {
    "allow": [
      "read_file(*)",
      "view_file(*)",
      "list_directory(*)",
      "file_search(*)",
      "grep_search(*)",
      "run_command(*)"
    ]
  }
}
EOF
fi

# Copy any externally mounted rules or skills
if [ -d "/etc/antigravity/rules" ]; then
    mkdir -p "${HOME}/.gemini/config/rules"
    cp -u /etc/antigravity/rules/* "${HOME}/.gemini/config/rules/" 2>/dev/null || true
fi
if [ -d "/etc/antigravity/skills" ]; then
    mkdir -p "${HOME}/.gemini/config/skills"
    cp -ru /etc/antigravity/skills/* "${HOME}/.gemini/config/skills/" 2>/dev/null || true
fi

# Extract PR URL from arguments
PR_URL=""
for arg in "$@"; do
    [[ "$arg" =~ ^https?:// ]] && PR_URL="$arg"
done

if [ -z "$PR_URL" ]; then
    echo "Usage: review-pr <PR_URL> [--post-comments]"
    echo "Example: review-pr https://dev.azure.com/myorg/myproject/_git/myrepo/pullrequest/1042"
    exit 1
fi

# Validate credentials
GEMINI_KEY="${GEMINI_API_KEY:-${GOOGLE_API_KEY:-}}"
ADO_PAT="${AZURE_DEVOPS_PAT:-${ADO_MCP_AUTH_TOKEN:-${SYSTEM_ACCESSTOKEN:-}}}"

if [ -z "$GEMINI_KEY" ] || [ -z "$ADO_PAT" ]; then
    echo "Error: GEMINI_API_KEY and AZURE_DEVOPS_PAT environment variables are required." >&2
    exit 1
fi

export GEMINI_API_KEY="$GEMINI_KEY"
export AZURE_DEVOPS_PAT="$ADO_PAT"
export AZURE_DEVOPS_EXT_PAT="$ADO_PAT"
export ADO_MCP_AUTH_TOKEN="$ADO_PAT"

# Configure Git credentials for Azure DevOps repositories
B64_PAT=$(printf ":%s" "$ADO_PAT" | base64 | tr -d '\n')
git config --global http.extraheader "Authorization: Basic $B64_PAT" || true

# Extract organization from URL
[[ "$PR_URL" =~ dev\.azure\.com/([^/]+) ]] && ORG="${BASH_REMATCH[1]}"
[[ "$PR_URL" =~ ([^/.]+)\.visualstudio\.com ]] && ORG="${BASH_REMATCH[1]}"
ORG="${AZURE_DEVOPS_ORG:-$ORG}"

if [ -z "$ORG" ]; then
    echo "Error: Could not determine Azure DevOps organization from PR URL: $PR_URL" >&2
    exit 1
fi

# Configure Azure CLI defaults if az is available
if command -v az >/dev/null 2>&1; then
    az devops configure --defaults organization="https://dev.azure.com/$ORG" 2>/dev/null || true
fi

# Ensure skill discovery in both global config and workspace directories
mkdir -p ~/.gemini/config/skills ~/.gemini/skills "${WORKSPACE_DIR:-/workspace}/.agents/skills"
if [ -d ~/.agents/skills/pr-review ]; then
    cp -ru ~/.agents/skills/pr-review ~/.gemini/config/skills/ 2>/dev/null || true
    cp -ru ~/.agents/skills/pr-review ~/.gemini/skills/ 2>/dev/null || true
    cp -ru ~/.agents/skills/pr-review "${WORKSPACE_DIR:-/workspace}/.agents/skills/" 2>/dev/null || true
fi

# Write MCP configuration to both config and root gemini paths
mkdir -p ~/.gemini/config ~/.gemini
for cfg in ~/.gemini/config/mcp_config.json ~/.gemini/mcp_config.json; do
cat <<EOF > "$cfg"
{
  "mcpServers": {
    "azure-devops": {
      "command": "mcp-server-azuredevops",
      "args": ["$ORG", "--authentication", "envvar", "-d", "repositories", "work-items", "core"],
      "env": {
        "ADO_MCP_AUTH_TOKEN": "$ADO_PAT"
      }
    },
    "git": {
      "command": "mcp-server-git",
      "args": ["--repository", "${WORKSPACE_DIR:-/workspace}"]
    }
  }
}
EOF
done

# Build review prompt
PROMPT="Use the 'pr-review' skill to review Azure DevOps Pull Request: $PR_URL."
if [[ "$*" == *"--post-comments"* ]]; then
    PROMPT="$PROMPT Post actionable review comments directly to the PR threads."
else
    PROMPT="$PROMPT Output your review report to stdout without posting comments."
fi

# Execute agy with auto-approved permissions for non-interactive review
exec agy -p "$PROMPT" --dangerously-skip-permissions
